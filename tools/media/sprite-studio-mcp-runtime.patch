diff --git a/src-tauri/src/rig/tests.rs b/src-tauri/src/rig/tests.rs
index 6a93964..c75f811 100644
--- a/src-tauri/src/rig/tests.rs
+++ b/src-tauri/src/rig/tests.rs
@@ -365,6 +365,50 @@ fn rig_persists_renders_into_assets_and_creates_an_animation() {
         .query_row("SELECT COUNT(*) FROM animations", [], |row| row.get(0))
         .expect("animation count");
     assert_eq!(animation_rows, 1, "rendered rigs become animations");
+
+    // MCP dispatch already runs inside Tokio. Exercise the complete synchronous
+    // render entry point there, rather than bypassing it via rendered frames.
+    // The old nested block_on panicked for both runtime flavors.
+    let mut first_runtime_frames = None;
+    for multithreaded in [false, true] {
+        let mut builder = if multithreaded {
+            tokio::runtime::Builder::new_multi_thread()
+        } else {
+            tokio::runtime::Builder::new_current_thread()
+        };
+        let runtime = builder.enable_all().build().expect("runtime");
+        let input = RigInput {
+            id: None,
+            workspace_id: saved.workspace_id.clone(),
+            worktree_id: None,
+            asset_id: Some(asset.id.clone()),
+            name: format!("runtime regression {multithreaded}"),
+            // One animated bone is a valid object rig; biped validation needs
+            // separate torso and limb movement, tested by the hero MCP trial.
+            morphology: "object".into(),
+            fps: saved.fps,
+            looping: saved.looping,
+            points: saved.points.clone(),
+            bones: saved.bones.clone(),
+            frames: saved.frames.clone(),
+        };
+        let rendered = runtime
+            .block_on(async { super::render_rig_animation_blocking(input, &state) })
+            .expect("native render inside an active Tokio runtime");
+        assert_eq!(rendered.animation.frames.len(), 2);
+        let pngs: Vec<Vec<u8>> = rendered.frame_paths.iter().map(|relative| {
+            let path = root.join(relative);
+            let decoded = image::open(&path).expect("decodable rendered PNG");
+            assert_eq!((decoded.width(), decoded.height()), (16, 16));
+            std::fs::read(path).expect("rendered PNG bytes")
+        }).collect();
+        assert_ne!(pngs[0], pngs[1], "rendered poses must actually differ");
+        if let Some(expected) = &first_runtime_frames {
+            assert_eq!(&pngs, expected, "runtime flavor must not change pixels");
+        } else {
+            first_runtime_frames = Some(pngs);
+        }
+    }
     drop(state);
     std::fs::remove_dir_all(root).expect("temporary fixture should be removable");
 }
