      {
        "id": "EF_IntroDialogue",
        "title": "Prolog — Pieczęć Popiołu",
        "objectId": "100000000000126",
        "revision": "83ed66c22641c7b0e31d53f79bfefd51ed786c810a908d190c206ba3407f02e7",
        "childTypes": {
          "DialogueFragment": 12,
          "Connection": 11
        },
        "connections": [
          {
            "source": "EF_IntroDialogue_L0000",
            "target": "EF_IntroDialogue_L0001"
          },
          {
            "source": "EF_IntroDialogue_L0001",
